+- inputs:
+    parameters:
+    - name: run-id
+    - name: sample-uuids
+    - name: enrichment-kit
+    - name: ref-base-dir
+    - name: scratch-base-dir
+  name: prepare-cnv-regions
+  outputs:
+    parameters:
+    - name: configmap-dir
+      valueFrom:
+        path: /tmp/cnv_configmap_dir.txt
+  script:
+    command:
+    - python
+    env:
+    - name: RUN_ID
+      value: '{{inputs.parameters.run-id}}'
+    - name: SAMPLE_UUIDS
+      value: '{{inputs.parameters.sample-uuids}}'
+    - name: ENRICHMENT_KIT
+      value: '{{inputs.parameters.enrichment-kit}}'
+    - name: REF_BASE_DIR
+      value: '{{inputs.parameters.ref-base-dir}}'
+    - name: SCRATCH_BASE_DIR
+      value: '{{inputs.parameters.scratch-base-dir}}'
+    - name: GENNEXT_CLUSTER_TOKEN
+      valueFrom:
+        secretKeyRef:
+          key: gennext_cluster_token
+          name: gennext-cluster-secrets
+    image: bergun/gennext-bed-validator:0.2.1
+    source: |
+      import json
+      import os
+      from pathlib import Path
+      import shutil
+      import subprocess
+      import urllib.parse
+      import urllib.request
+
+      ref = Path(os.environ["REF_BASE_DIR"])
+      scratch = Path(os.environ["SCRATCH_BASE_DIR"]) / "cnv" / "inputs"
+      config = scratch / "config"
+      config.mkdir(parents=True, exist_ok=True)
+      for entry in Path("/mnt/configmap").iterdir():
+          if entry.is_file():
+              shutil.copyfile(entry, config / entry.name)
+      params = urllib.parse.urlencode({"runId": os.environ["RUN_ID"], "detailed": "true"})
+      request = urllib.request.Request(
+          "http://gennext-backend.gennext-prod.svc.cluster.local:3030/api/v0/cluster/run?" + params,
+          headers={"X-Api-Key": os.environ["GENNEXT_CLUSTER_TOKEN"]},
+      )
+      with urllib.request.urlopen(request, timeout=60) as response:
+          samples = {sample["sampleUuid"]: sample for sample in json.load(response)["samples"]}
+      selected = json.loads(os.environ["SAMPLE_UUIDS"])
+      if not selected:
+          raise ValueError("No samples selected")
+      gtf = ref / "hg38/gene_annots/gencode.v49.basic.annotation.MANE_Select.gtf.gz"
+      chains = ref / "hg38/other/chains"
+      validated = {}
+      for uuid in selected:
+          sample = samples[uuid]  # Fail closed for missing UUIDs.
+          kit = sample.get("enrichmentKit") or os.environ["ENRICHMENT_KIT"]
+          design = kit.split(" - ")[-1].split("_")[0].strip()
+          key = "hg38.somtest." + design + ".regions.sv-cnv"
+          # An explicit source key is preferred; legacy .valid.bed configuration
+          # refers to the source with the same stem, never to a shared artifact.
+          source_key = Path("/mnt/configmap") / (key + "-source")
+          configured = (source_key if source_key.is_file() else Path("/mnt/configmap") / key).read_text().strip()
+          source = ref / configured
+          if source.name.endswith(".valid.bed"):
+              source = source.with_name(source.name.removesuffix(".valid.bed") + ".bed")
+          if not source.is_file():
+              raise FileNotFoundError(f"Source CNV BED for {sample['sampleId']}: {source}")
+          if source not in validated:
+              dest = scratch / "beds" / design / (source.stem + ".valid.bed")
+              dest.parent.mkdir(parents=True, exist_ok=True)
+              subprocess.run([
+                  "python", "/app/main.py", str(source), "--target-version", "hg38",
+                  "--gtf", str(gtf), "--chains-dir", str(chains),
+                  "--output", str(dest), "--output-report", str(dest.with_suffix(".json")),
+                  "--canonical-only",
+              ], check=True)
+              if not dest.is_file() or not dest.stat().st_size:
+                  raise ValueError(f"Validator produced an empty BED: {dest}")
+              validated[source] = dest
+          # Absolute scratch paths override only this workflow's private config.
+          (config / key).write_text(str(validated[source]))
+          print(f"{sample['sampleId']}: {source} -> {validated[source]}")
+      Path("/tmp/cnv_configmap_dir.txt").write_text(str(config))
+    volumeMounts:
+    - mountPath: '{{inputs.parameters.ref-base-dir}}'
+      name: cnv-source-ref
+      readOnly: true
+    - mountPath: /mnt/configmap
+      name: cnv-source-config
+      readOnly: true
+    - mountPath: '{{inputs.parameters.scratch-base-dir}}'
+      name: cnv-source-scratch
+  volumes:
+  - hostPath:
+      path: '{{inputs.parameters.ref-base-dir}}'
+      type: Directory
+    name: cnv-source-ref
+  - configMap:
+      name: gennext-references
+    name: cnv-source-config
+  - hostPath:
+      path: '{{inputs.parameters.scratch-base-dir}}'
+      type: DirectoryOrCreate
+    name: cnv-source-scratch
